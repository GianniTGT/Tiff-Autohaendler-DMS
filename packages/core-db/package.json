{
  "name": "@tiff/core-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "migrate": "node-pg-migrate up --migrations-dir migrations --envPath ../../.env",
