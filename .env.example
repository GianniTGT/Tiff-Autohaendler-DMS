# Kopieren nach .env und ausfüllen. Nie committen (siehe .gitignore).
#
# ZWEI Rollen, nicht eine — siehe packages/core-db/migrations/
# 1700000000004_runtime-role-hardening.js für die Begründung: eine Rolle, die
# ihre eigenen Tabellen besitzt, ist von Row Level Security befreit, egal was
# die Policy sagt.

# Migrationen: die Rolle, die die Tabellen besitzt (z.B. tiff_migrator, oder
# lokal der DB-Owner). Nur für `npm run migrate` verwendet, nie von der
# laufenden Anwendung.
MIGRATE_DATABASE_URL=postgres://tiff_migrator:CHANGE_ME@localhost:5432/tiff_autohaendler_dms

# Laufzeit: die Rolle, mit der sich der Server verbindet. Besitzt nichts,
# hat kein BYPASSRLS — siehe packages/core-db/src/index.js.
DATABASE_URL=postgres://tiff_app:CHANGE_ME@localhost:5432/tiff_autohaendler_dms

# Absichtlich nicht 3000 — das kollidiert leicht mit anderen lokal
# laufenden Node-Projekten (z.B. ein paralleles Next.js-Projekt, dessen
# Dev-Server standardmässig auch 3000 belegt). vite.config.js proxied /api
# auf denselben Port — beim Ändern dort mitziehen.
PORT=3010

# Objektspeicher für archivierte Belege (Phase 3, siehe
# apps/cardealer-ch/server/src/integrations/object-storage/store.js).
# Ohne OBJECT_STORAGE_ENDPOINT: lokales Dateisystem, <cwd>/data/objects —
# nur für Entwicklung, der Container ist vergänglich. Für den Betrieb
# S3-kompatibel (Exoscale SOS, cloudscale.ch, Infomaniak Swiss Backup, alle
# mit Datenhaltung in der Schweiz — siehe SCHWEIZ-SAAS.md §2):
# OBJECT_STORAGE_ENDPOINT=https://sos-ch-gva-2.exo.io
# OBJECT_STORAGE_REGION=ch-gva-2
# OBJECT_STORAGE_BUCKET=tiff-autohaendler-dms-belege
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=

# Schlüssel für Geheimnisse in der Datenbank (AutoScout24-Client-Secret):
# AES-256-GCM, 32 Byte als 64 Hex-Zeichen oder Base64. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Im Betrieb (NODE_ENV=production) Pflicht — ohne ihn werden keine
# Zugangsdaten gespeichert oder gelesen. Lokal fehlt er ohne Schaden (fester
# Entwicklungsschlüssel). Den Schlüssel NICHT zusammen mit Datenbank-Backups
# aufbewahren, sonst schützt die Verschlüsselung nichts.
# APP_SECRET_KEY=
